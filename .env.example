# Server
NODE_ENV=production
PORT=5000
JWT_SECRET=<generate-a-long-random-string>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-admin-password>

# CORS — comma-separated frontend origins (set after Vercel deploy)
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-admin.vercel.app

# Database (Neon)
DATABASE_URL=<your-neon-postgres-url>

# Firebase Admin — base64 of firebase-service-account.json
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("firebase-service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=<base64-service-account-json>

# Cloudflare R2
R2_ACCOUNT_ID=<account-id>
R2_ACCESS_KEY_ID=<access-key>
R2_SECRET_ACCESS_KEY=<secret-key>
R2_BUCKET_NAME=customerdocs
R2_PUBLIC_BASE_URL=

# Razorpay
RAZORPAY_KEY_ID=<key-id>
RAZORPAY_KEY_SECRET=<key-secret>
RAZORPAY_WEBHOOK_SECRET=<webhook-secret-after-setup>

# SMS (optional — MSG91 / Fast2SMS, parked for now)
MSG91_AUTHKEY=
MSG91_ROUTE=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=

# Pricing
GST_RATE=0
